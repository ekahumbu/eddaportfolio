---
// Shown for any address that doesn't exist. Vercel serves dist/404.html automatically.
import Base from "../layouts/Base.astro";
import { profile } from "../data/site";
---

<Base title={`Page not found | ${profile.name}`} description="This page doesn't exist.">
  <section>
    <h1>Page not found</h1>
    <p>That page doesn't exist, or it has moved.</p>
    <p><a href="/">Go to the home page</a> or <a href="/#tasks">see the sample tasks</a>.</p>
  </section>
</Base>
