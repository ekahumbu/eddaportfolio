---
import Base from "../layouts/Base.astro";
import TaskGrid from "../components/TaskGrid.astro";
import ToolStack from "../components/ToolStack.astro";
import { getTasks, getLog, getTools } from "../lib/content";

// Loading the content runs the build checks (see src/lib/content.ts).
const [tasks, , tools] = await Promise.all([getTasks(), getLog(), getTools()]);
---

<Base title="Edda" description="Sample tasks showing work that keeps moving, organised and checked.">
  <p class="label">Site setup</p>
  <h1>Work that keeps moving, organised and checked.</h1>
  <p>Base layout, colour tokens and fonts are in place. Content comes next.</p>
  <TaskGrid tasks={tasks} />
  <ToolStack tools={tools} tasks={tasks} />
</Base>
