---
// The shared page frame. Every page wraps its content in <Base> ... </Base>.
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

// Plus Jakarta Sans (headings and text), Newsreader (quotes), JetBrains Mono (labels).
const fontsUrl =
  "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

// Link previews need full web addresses, built from `site` in astro.config.mjs.
// Until it is set, a TODO: marker goes into the page and the production build fails.
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : "TODO: set site in astro.config.mjs");
const pageUrl = abs(Astro.url.pathname);
const imageUrl = abs("/og.png");
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />

    <!-- Link previews (LinkedIn, Slack, WhatsApp, email). The image is made by scripts/make-og-image.mjs. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eddah Dena" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eddah Dena: give me a loose brief, I'll hand back organized, checked work." />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f7f2e3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131211" media="(prefers-color-scheme: dark)" />

    <!-- Only the weights the site uses; display=swap shows text straight away. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- media="print" + onload makes the font CSS load without blocking the first paint. -->
    <link
      rel="stylesheet"
      href={fontsUrl}
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href={fontsUrl} />
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="wrap">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
