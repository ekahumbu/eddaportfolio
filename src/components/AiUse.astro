---
// "How I use AI": one line per tool, then Eddah's rule. Text lives in src/data/ai.ts.
import { aiUses, aiRule } from "../data/ai";
import SectionHead from "./SectionHead.astro";

interface Props {
  num?: string;
}
const { num } = Astro.props;
---

<section id="ai" aria-labelledby="ai-heading">
  <SectionHead id="ai-heading" num={num} label="AI" title="How I use AI" />
  <dl>
    {aiUses.map((a) => (
      <div>
        <dt>{a.tool}</dt>
        <dd>{a.use}</dd>
      </div>
    ))}
  </dl>
  <blockquote>{aiRule}</blockquote>
  <p class="label">Each sample task says exactly what AI did and what I checked.</p>
</section>

<style>
  dl { margin: 0 0 1.5rem; }
  dl div { display: grid; gap: 0.1rem; padding: 0.5rem 0; border-top: 1px solid var(--rule); }
  @media (min-width: 768px) { dl div { grid-template-columns: 9rem 1fr; gap: 1rem; } }
  dt { font-weight: 600; }
  dd { margin: 0; }
  blockquote { margin: 0 0 0.5rem; padding-left: 1rem; border-left: 3px solid var(--accent); font-family: var(--font-story); font-size: clamp(1.35rem, 3vw, 1.75rem); line-height: 1.35; }
</style>
