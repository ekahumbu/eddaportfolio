---
import { profile } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap row label">
    <p>© {year} {profile.name} · {profile.location}</p>
    <ul>
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
      <li><a href={profile.linkedin}>LinkedIn</a></li>
      <li><a href="#main">Back to top <span aria-hidden="true">↑</span></a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--rule); padding: 1.5rem 0 2rem; }
  .row { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; justify-content: space-between; align-items: baseline; }
  p { margin: 0; }
  ul { display: flex; flex-wrap: wrap; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  a { color: var(--muted); }
  a:hover { color: var(--accent); }
</style>
