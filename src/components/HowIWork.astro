---
// Four steps, in the order they happen, so they're an ordered list.
import SectionHead from "./SectionHead.astro";

interface Props {
  num?: string;
}
const { num } = Astro.props;

const points = [
  {
    title: "Clarify the goal",
    text: "I ask targeted questions to define the objective, deadline, and what \"done\" looks like. I'm highly async-friendly, so I document everything upfront to save us from unnecessary calls.",
  },
  {
    title: "Structure the mess",
    text: "I take your loose brief or zero-draft and break it into actionable steps. I set up simple tracking and flag missing info early so the project never stalls.",
  },
  {
    title: "Execute and verify",
    text: "I do the deep work, then run it through a strict personal QA checklist. I don't hand over anything I haven't double-checked, so it arrives polished and ready to use.",
  },
  {
    title: "Deliver and refine",
    text: "I present the final output with clear notes on any decisions you need to make. I track lessons learned in my Build Log, ensuring transparent, continuous improvement.",
  },
];
---

<section id="how-i-work" aria-labelledby="work-heading">
  <SectionHead id="work-heading" num={num} label="Process" title="How I work" />
  <ol>
    {points.map((p) => (
      <li><h3>{p.title}</h3><p>{p.text}</p></li>
    ))}
  </ol>
</section>

<style>
  ol { display: grid; gap: 1.5rem 2.5rem; padding: 0; margin: 0; list-style: none; counter-reset: step; }
  @media (min-width: 768px) { ol { grid-template-columns: 1fr 1fr; } }
  li { padding-top: 0.25rem; }
  h3 { font-size: 1.15rem; margin-bottom: 0.35rem; }
  /* Step number above each title: 01, 02... */
  h3::before {
    counter-increment: step;
    content: "0" counter(step);
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--accent);
  }
  p { margin: 0; }
</style>
