---
// First screen: name, one-line promise, availability, the live "Now" line, two buttons.
import type { CollectionEntry } from "astro:content";
import { profile } from "../data/site";

interface Props {
  latest?: CollectionEntry<"log">; // newest Build log entry
  headline?: string; // track pages pass their own line
}
const { latest, headline = "Work that keeps moving, organized and checked." } = Astro.props;
---

<header class="hero">
  <p class="label">{profile.name} · {profile.location} · {profile.hours}</p>
  <h1>{headline}</h1>
  <p class="lead">Sample tasks that show I can take a messy brief and hand back clean, usable work.</p>

  {latest && (
    <p class="now">
      <span class="label">Now · <time datetime={latest.data.date.toISOString().slice(0, 10)}>{latest.data.date.toISOString().slice(0, 10)}</time></span>
      <a href="/log">{latest.data.title}</a>
    </p>
  )}

  <p class="buttons">
    <a class="button primary" href="#tasks">See sample tasks</a>
    <a class="button" href="#contact">Contact</a>
  </p>
</header>

<style>
  .hero { padding-top: 3rem; }
  .lead { font-size: 1.25rem; max-width: 36rem; }
  .now { display: flex; flex-direction: column; gap: 0.15rem; border-left: 3px solid var(--accent); padding-left: 0.75rem; margin: 1.5rem 0; }
  .buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .button { display: inline-block; padding: 0.6rem 1.1rem; border: 1px solid var(--ink); color: var(--ink); text-decoration: none; font-weight: 600; }
  .button.primary { background: var(--accent); border-color: var(--accent); color: var(--paper); }
</style>
