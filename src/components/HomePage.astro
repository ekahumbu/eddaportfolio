---
// The full home layout. The home page uses it as is; each /for/<track> page uses it
// with a track, which changes the headline and lists that track's tasks first.
import Base from "../layouts/Base.astro";
import Hero from "./Hero.astro";
import About from "./About.astro";
import TaskGrid from "./TaskGrid.astro";
import HowIWork from "./HowIWork.astro";
import ToolStack from "./ToolStack.astro";
import AiUse from "./AiUse.astro";
import BuildLog from "./BuildLog.astro";
import Contact from "./Contact.astro";
import { getTasks, getLog, getTools } from "../lib/content";
import { profile } from "../data/site";

interface Props {
  track?: { name: string; heroLine: string };
}
const { track } = Astro.props;

// Loading the content runs the build checks (see src/lib/content.ts).
const [tasks, log, tools] = await Promise.all([getTasks(), getLog(), getTools()]);

const title = track ? `${profile.name} | ${track.name}` : `${profile.name} | Executive support, operations and analysis`;
const description = track ? track.heroLine : "Give me a loose brief and I'll hand back organized, checked work. Sample tasks in executive support, operations and analysis.";
---

<Base title={title} description={description}>
  <Hero latest={log[0]} headline={track?.heroLine} />
  <About num="01" />
  <TaskGrid num="02" tasks={tasks} firstTrack={track?.name} />
  <HowIWork num="03" />
  <ToolStack num="04" tools={tools} tasks={tasks} />
  <AiUse num="05" />
  <BuildLog num="06" entries={log} limit={3} />
  <Contact num="07" />
</Base>
