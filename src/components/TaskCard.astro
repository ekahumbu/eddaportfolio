---
// One sample task as a card. Every card uses this same layout.
import type { CollectionEntry } from "astro:content";
import { tracks } from "../data/site";

interface Props {
  task: CollectionEntry<"tasks">;
}
const { task } = Astro.props;
const d = task.data;

// Tracks this task is evidence for: its own role plus any in alsoShows.
const shows = [d.role, ...d.alsoShows];
const trackSlug = tracks.find((t) => t.name === d.role)?.slug;
---

<li class="card" data-tracks={shows.join("|")}>
  <p class="tag" data-track={trackSlug}>
    {shows.join(" · ")}
    {d.draft && <span class="draft"> · Draft</span>}
  </p>
  <h3><a href={`/tasks/${task.id}`}>{d.title}</a></h3>
  <p class="summary">{d.summary}</p>
  <p class="outcome">{d.outcome}</p>
  <!-- Time, tools and AI as badges, so a reader can take them in at a glance. -->
  <dl class="facts">
    <div><dt>Time</dt><dd>{d.timeTaken}</dd></div>
    <div><dt>Tools</dt><dd>{d.tools.join(", ")}</dd></div>
    {d.aiTools.length > 0 && <div class="ai"><dt>AI</dt><dd>{d.aiTools.join(", ")}</dd></div>}
  </dl>
  <ul class="skills label">
    {d.skills.map((s) => <li>{s}</li>)}
  </ul>
</li>

<style>
  .card {
    list-style: none;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--raised);
    padding: 1.5rem;
    transition: border-color 0.2s;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card:hover { border-color: var(--muted); }
  .card[hidden] { display: none; }
  h3 { font-size: 1.25rem; line-height: 1.25; margin: 0; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  p { margin: 0; }
  .summary { color: var(--ink); }
  .outcome { border-left: 3px solid var(--accent); padding-left: 0.75rem; font-weight: 600; }

  /* Track tag: text label plus a small shape, so it never relies on color. */
  .tag {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tag::before {
    content: "";
    width: 0.6rem;
    height: 0.6rem;
    border: 2px solid var(--accent);
    flex: none;
  }
  .tag[data-track="executive-support"]::before { border-radius: 0; }          /* square */
  .tag[data-track="operations"]::before { border-radius: 50%; }               /* circle */
  .tag[data-track="analyst"]::before { transform: rotate(45deg); }            /* diamond */

  .facts { margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .facts div {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: var(--paper);
  }
  .facts dt { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .facts dd { margin: 0; font-size: 0.875rem; font-weight: 600; }
  .facts .ai { border-color: var(--accent); }
  .facts .ai dd { color: var(--accent); }
  .skills { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0.25rem 0 0; list-style: none; }
  .skills li { border: 1px solid var(--rule); padding: 0 0.5rem; }
</style>
