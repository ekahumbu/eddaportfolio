---
// Build log as dated notebook lines. Used on the home page (latest 3) and on /log (all).
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"log">[]; // newest first
  limit?: number;
  heading?: string;
}
const { entries, limit, heading = "Build log" } = Astro.props;
const shown = limit ? entries.slice(0, limit) : entries;

// Render each entry's Markdown body.
const rendered = await Promise.all(
  shown.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<section id="log" aria-labelledby="log-heading">
  <h2 id="log-heading">{heading}</h2>
  {rendered.length === 0 ? (
    <p>The first entries are on the way.</p>
  ) : (
    <ol>
      {rendered.map(({ entry, Content }) => (
        <li>
          <p class="meta label">
            <time datetime={entry.data.date.toISOString().slice(0, 10)}>{entry.data.date.toISOString().slice(0, 10)}</time>
            <span class="kind">{entry.data.kind}</span>
          </p>
          <h3>{entry.data.title}</h3>
          <div class="text"><Content /></div>
          {entry.data.task && <p class="label"><a href={`/tasks/${entry.data.task}`}>Related sample task</a></p>}
        </li>
      ))}
    </ol>
  )}
  {limit && entries.length > 0 && <p><a href="/log">All log entries</a></p>}
</section>

<style>
  ol { padding: 0; margin: 0 0 1rem; list-style: none; }
  li { padding: 0.9rem 0 0.9rem 1rem; border-left: 2px solid var(--rule); border-bottom: 1px dashed var(--rule); }
  .meta { display: flex; gap: 0.75rem; margin: 0 0 0.25rem; }
  /* The kind label is outlined text, not a colour. */
  .kind { border: 1px solid var(--muted); padding: 0 0.4rem; color: var(--ink); }
  h3 { font-size: 1.35rem; margin-bottom: 0.25rem; }
  .text :global(p) { margin-bottom: 0.5rem; }
</style>
